# LLM endpoint: an open-weight model served OpenAI-compatible (e.g. vLLM) on a teammate's HPC cluster
# that is approved for sensitive data. Every call that carries dataset content goes here and nowhere else.
# Copy this file to .env and fill it in. .env is gitignored. Verify with: python scripts/check_llm.py
LLM_BASE_URL=https://cluster.example/v1
LLM_API_KEY=
LLM_MODEL=
