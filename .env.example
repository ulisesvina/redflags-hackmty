# Browser/API routing
NEXT_PUBLIC_REDFLAGS_API_URL=/api/redflags
REDFLAGS_BACKEND_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000

# Investigation engine
FORENSIC_ENGINE_PYTHON=./backend/.venv/bin/python
CASE_STORAGE_ROOT=./backend/runtime/cases

# Optional local multimodal extraction (never the verdict engine)
ENABLE_OMLX=0
OMLX_URL=http://localhost:8000/v1/chat/completions
OMLX_MODEL=Qwen2.5-VL-3B-Instruct-4bit

# Gemini: redacted, evidence-bounded judge Q&A
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas: finalized case + evidence-manifest persistence
MONGODB_URI=
MONGODB_DATABASE=redflags

# Solana: optional SHA-256 manifest anchoring; use a funded devnet-only key
SOLANA_SECRET_KEY=
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Vultr: set in the deployed environment to expose live status
VULTR_PUBLIC_URL=
